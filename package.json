{
  "name": "excel-file-rw",
  "version": "1.0.0",
  "description": "Read and write .xlsx files in the browser and Node.js with zero dependencies. Combines the read-excel-file and write-excel-file style APIs.",
  "type": "module",
  "main": "./src/node.js",
  "module": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "node": {
        "types": "./types/node.d.ts",
        "default": "./src/node.js"
      },
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./node": {
      "types": "./types/node.d.ts",
      "default": "./src/node.js"
    },
    "./browser": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "types",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./src/node.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "fixtures": "python3 scripts/make-fixtures.py"
  },
  "keywords": [
    "excel",
    "xlsx",
    "spreadsheet",
    "read",
    "write",
    "parse",
    "export",
    "json",
    "schema",
    "browser",
    "zero-dependency"
  ],
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {}
}
